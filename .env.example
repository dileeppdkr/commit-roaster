# Copy to .env, fill in, then load it with:  set -a; source .env; set +a
# .env is git-ignored. Never commit a real key.
# Every ROAST_* setting is optional: leave it out to use the default shown.
# CLI flags win over these.

# Required: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- Model -------------------------------------------------------------------
# Claude model ID (--model)
ROAST_MODEL=claude-haiku-5-5
# Thinking effort: low | medium | high | xhigh | max (--effort)
ROAST_EFFORT=low
# Cap on Claude's reply, thinking included (--max-tokens)
# ROAST_MAX_TOKENS=16000

# --- What gets sent ----------------------------------------------------------
# Larger diffs are cut, with a warning (--max-diff-chars)
# ROAST_MAX_DIFF_CHARS=60000
# More files to leave out, comma-separated, added to the defaults (--exclude)
# ROAST_EXCLUDE=app/assets/builds,coverage

# --- What to review ----------------------------------------------------------
# Areas, comma-separated, or "all" (--focus):
# bugs, security, sql, performance, side-effects, patterns, reuse, best-practices, tests
# ROAST_FOCUS=security,sql,performance
# Let Claude read and search the codebase; slower, costs more (--deep)
# ROAST_DEEP=false
# Tool-call limit for deep reviews (--max-tool-calls)
# ROAST_MAX_TOOL_CALLS=20
# Skip stack detection, comma-separated (--stack):
# rails, ruby, react, angular, node, laravel, php, django, python, spring, java, go, dotnet
# ROAST_STACK=rails,react
# Team review rules file; empty for none (--rules / --no-rules). Default: .roast.md
# ROAST_RULES=docs/review-rules.md
