# Copy to .env, fill in, then load it with:  set -a; source .env; set +a
# .env is git-ignored. Never commit a real key.

# Required: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides (CLI flags win over these)
ROAST_MODEL=claude-haiku-5-5
ROAST_EFFORT=low            # low | medium | high | xhigh | max
# ROAST_MAX_DIFF_CHARS=60000
